Comment": null, "status": 1, "createdAt": 1658035550000, "updatedAt": "2022-07-17T05:25:50.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 4124801, "messageId": 2247, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\uc74c\uc545\uc801\uc778 \ud2b9\uc131\uc73c\ub85c\ub294 \uc720\ub7fd\uc758 \ud074\ub798\uc2dd \uc74c\uc545, \ud1a0\uc18d\uc801\uc778 \uc9d1\uc2dc \uc74c\uc545, \ube14\ub8e8\uc2a4\uc5d0\uc11c \uc601\ud5a5\uc744 \ubc1b\uc740 \ube14\ub8e8\uc2a4 \uc2a4\ucf00\uc77c, \ub2e4\uc591\ud558\uac8c \ubc1c\uc804\uc2dc\ud0a8 \ucf54\ub4dc \ubb38\ubc95\ub4e4, \ube14\ub8e8\ub178\ud2b8 \uc9c4\ud589, \uc989\ud765\uc131(Improvisation), \ub2f9\uae40\uc74c(Syncopation), \uc2a4\uc719(Swing)\ub9ac\ub4ec \ub4f1\uc758 \uc0c8\ub85c\uc6b4 \uc2dc\ub3c4, 20\uc138\uae30 \ucd08\ubc18\uc5d0 \uc0c8\ub85c\uc774 \ub4f1\uc7a5\ud55c \uc608\uc220 \uc7a5\ub974\uc778 \ubba4\uc9c0\uceec \ubc0f \uc601\ud654\uc640\uc758 \ud3ed\ub113\uc740 \uad50\ub958\uc640 \uc218\uc6a9[13] \ub4f1 \uc5ec\ub7ec \uc74c\uc545\uc801 \uc694\uc18c\uac00 \ud63c\ud569\ub418\uc5b4 \uc788\ub2e4\ub294 \uc810 \ub4f1\uc744 \ub4e4 \uc218 \uc788\ub2e4. \uc774\ub807\uac8c \ud0c4\uc0dd\ud55c \uc7ac\uc988 \ub610\ud55c \ube14\ub8e8\uc2a4\uc640 \ud568\uaed8 \uc774\ud6c4\uc5d0 \ub4f1\uc7a5\ud558\ub294 \ub2e4\uc591\ud55c \ub300\uc911\uc74c\uc545 \uc7a5\ub974\uc758 \uc2e4\uc9c8\uc801\uc778 \ubaa8\ud0dc\uac00 \ub418\uc5c8\ub294\ub370, 20\uc138\uae30 \uc911\ubc18\ubd80\ud130 \uc8fc\ub958\uac00 \ub41c \uc7a5\ub974\uc778 \ub9ac\ub4ec \uc564 \ube14\ub8e8\uc2a4\uc640 \ub85c\ud070\ub864\uc744 \ubcf4\uba74, \uc7ac\uc988\uc5d0\uc11c \uc815\uad50\ud558\uac8c \ubc1c\uc804\uc2dc\ud0a8 \ub3c5\ud2b9\ud55c \uc74c\uc545\uc801 \uad6c\uc870\ub098 \ubb38\ubc95, \ub2e4\uc591\ud55c \uc74c\uc545\uc801 \ucf54\ub4dc \ubc0f \ud654\uc131\ud559 \uc774\ub860\ub4e4\uc774 \ud655\uc5f0\ud788 \ub179\uc544\uc788\uc74c\uc744 \ud655\uc778\ud560 \uc218 \uc788\ub2e4.\n\n\uc8fc\uc694 \uc0ac\uc6a9\uc545\uae30\uc5d0\ub294 \ub4dc\ub7fc, \ucf58\ud2b8\ub77c\ubca0\uc774\uc2a4, \uccbc\ub85c, \ud53c\uc544\ub178, \uae30\ud0c0, \uc0c9\uc18c\ud3f0, \ud074\ub77c\ub9ac\ub137, \ud2b8\ub7fc\ud3ab, \ud2b8\ub7fc\ubcf8 \ub4f1\uc774 \uc788\ub2e4.", "voiceComment": null, "status": 1, "createdAt": 1658035567000, "updatedAt": "2022-07-17T05:26:07.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 4124806, "messageId": 2247, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\uc7ac\uc988\ub780 \ub9d0\uc774\uc8e0", "voiceComment": null, "status": 1, "createdAt": 1658035575000, "updatedAt": "2022-07-17T05:26:15.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 4124831, "messageId": 2247, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\ub178\uc7bc\uc774\ub77c\ub1e8 \u315c", "voiceComment": null, "status": 1, "createdAt": 1658035600000, "updatedAt": "2022-07-17T05:26:40.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 4124858, "messageId": 2247, "parentId": 0, "pollId": 0, "userI