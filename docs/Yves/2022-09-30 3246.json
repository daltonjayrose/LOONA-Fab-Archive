edAt": 1664600644000, "updatedAt": "2022-10-01T05:04:04.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": "\uc9d1\ucf55 \uc131\ud5a5\ud14c\uc2a4\ud2b8 \ud55c\uae40\uc5d0 \uc774\uac83\ub450 \u3131\u3131 \n\nhttps://www.banggooso.com/gl/136/", "profileImageComment": null}, {"id": 5189944, "messageId": 3246, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "# \ucd08\uac00\uc744\uc744 \ub2ee\uc740 \ub098\ub294\n\uc300\uc300\ud55c \ubc14\ub78c\uacfc \ud568\uaed8 \uace0\ub3c5\uc744 \uc990\uae30\ub294 \ud3b8... \ud63c\uc790 \uc788\ub294 \uc2dc\uac04\uc744 \ub204\uad6c\ubcf4\ub2e4 \uc88b\uc544\ud574\uc694.\n\ud55c \ubc88 \uc774\ub8e8\uace0\uc790 \ub9c8\uc74c\uba39\uc73c\uba74 \ucca0\uc800\ud55c \uacc4\ud68d\uacfc \ucd94\uc9c4\ub825\uc73c\ub85c \ubc00\uace0 \ub098\uac00\uc694.\n\ub2f5\ub2f5\ud558\uac8c \ube59\ube59 \ub3cc\ub824 \ub9d0\ud558\uae30\ubcf4\ub2e4\ub294 \uc2dc\uc6d0 \uc194\uc9c1\ud558\uac8c \ub9d0\ud558\ub294 \ud3b8\uc774\uc5d0\uc694.\n\uc194\uc9c1\ud788 \ub0b4\uac00 \ubd10\ub3c4 \uba4b\uc788\uc744 \ub54c\uac00 \ub9ce\uc9c0\ub9cc... \uac89\uc73c\ub85c\ub294 \uc544\ubb34\ub807\uc9c0 \uc54a\uc740 \ucc99\ud574\uc694.\n# \ub098\uc758 \uacc4\uc808\uc774 \uadf8\ub9ac\uc6b4 \uc21c\uac04\uc740\n\ud63c\uc790 \uc870\uc6a9\ud788 \uc2dc\uac04\uc744 \ubcf4\ub0b4\uace0 \uc2f6\uc5b4\uc9c8 \ub54c \uc0dd\uac01\ub098\uc694.\n\uc18d\uc774 \ub2f5\ub2f5\ud574\uc11c \ubee5 \ub6ab\ub838\uc73c\uba74 \ud560 \ub54c \uadf8\ub9ac\uc6cc\uc838\uc694.\n\ud655\uc2e4\ud55c \uacb0\ub2e8\ub825\uc774 \ud544\uc694\ud55c \uc21c\uac04\uc5d0 \ub354 \ubcf4\uace0 \uc2f6\uc5b4\uc694.\n# \uc0ac\ub77c\uc838\uac00\ub294 \ub098\uc758 \uacc4\uc808\uc744 \uc9c0\ud0a4\uae30 \uc704\ud574\uc11c\ub294\n\uc6b0\ub9ac\uc758 \uc0ac\uacc4\uc808\uc744 \ub418\ucc3e\uc544\uc900 \uc18c\ubb38\uc758 \uac00\uac8c\ub97c \uc8fc\ubcc0\uc5d0\uc11c\ub3c4 \ub9cc\ub0a0 \uc218 \uc788\ub2e4\ub294\ub370...\n\u2018\uc544\ub984\ub2e4\uc6b4\uac00\uac8c\u2019\uc5d0 \uc4f0\uc9c0 \uc54a\ub294 \ubb3c\uac74\uc744 \uae30\ubd80\ud558\uba74, \ub2e8\ud48d\uc774 \uc2dc\uc791\ud558\ub294 \ucd08\uac00\uc744\uc744 \uc9c0\ud0ac \uc218 \uc788\ub2e4\uace0 \ud574\uc694!\n\ub0ad\ube44\ub418\ub294 \uc790\uc6d0\uc744 \uc808\uc57d\ud574\uc11c \uae30\ud6c4 \uc704\uae30\uc5d0 \ucde8\uc57d\ud55c \uc774\uc6c3\ub4e4\uae4c\uc9c0 \ub3c4\uc6b8 \uc218 \uc788\ub2e4\ub294 \uc0ac\uc2e4!\n\uc77c\uc0c1 \uc18d \ub098\ub214\uc73c\ub85c \uae30\ud6c4 \uc704\uae30\ub85c\ubd80\ud130 \uc0ac\ub77c\uc838\uac00\ub294 \ub098\uc758 \uacc4\uc808\uc744 \uc9c0\ucf1c\ubcf4\ub294 \uac74 \uc5b4\ub54c\uc694?", "voiceComment": null, "status": 1, "createdAt": 1664600783000, "updatedAt": "2022-10-01T05:06:23.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 5189960, "messageId": 3246, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\ub0b4\uac00\ubd10\ub3c4\uba4b\uc788\uc744\ub54c\uac00\ub9ce\uc9c0\ub9cc..\ud83e\udd14", "voiceComment": null, "status": 1, "createdAt": 1664600794000, "updatedAt": "2022-10-01T05:06:34.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 5189966, "messageId": 3246, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\ud0b9\ubc1b\ub294\ud3ec\uc778\ud2b8\ub124", "voiceComment": null, "status": 1, "createdAt": 1664600798000, "updatedAt