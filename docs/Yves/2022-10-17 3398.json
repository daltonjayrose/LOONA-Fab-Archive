: "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 5366655, "messageId": 3398, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\uc800 \uc5c5\ub383\uc548\ud587\uc544\uc694\u2026^*^", "voiceComment": null, "status": 1, "createdAt": 1666089989000, "updatedAt": "2022-10-18T10:46:29.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 5366673, "messageId": 3398, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 3, "comment": "\uc640 \uc5b8\ub2c8\ubaa8\uc57c \ub300\ubc15\uac10\uc0ac\ubd64\u3160\ud83d\udc96", "voiceComment": null, "status": 1, "createdAt": 1666090035000, "updatedAt": "2022-10-18T10:47:15.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": "\ud638\ub791\uc774 \uc720\ud615 \uc911 INFJ \uc131\uaca9\uc744 \uac00\uc9c4 \uc0ac\ub78c\uc740\n\uac15\ud55c \uc9c1\uad00\ub825\uc758 \uc18c\uc720\uc790\ub85c \uc774\uc0c1\uc8fc\uc758\uc801, \uc644\ubcbd\uc8fc\uc758\uc801 \uc131\ud5a5\uc744 \ucd94\uad6c\ud569\ub2c8\ub2e4.\n\ucc3d\uc758\ub825\uacfc \ud1b5\ucc30\ub825\uc774 \ub6f0\uc5b4\ub098 \ub3c5\ucc3d\uc801\uc778 \uc0dd\uac01\uc774 \ub9ce\uc73c\uba70 \uc870\uc6a9\ud558\uc9c0\ub9cc, \ub3c5\ub9bd\uc2ec\uc774 \uac15\ud569\ub2c8\ub2e4.\n\uc5b4\ub5a4 \uc77c\uc744 \ud560 \ub54c \uadf8 \uc77c\uc774 \uac16\ub294 \uc758\ubbf8\uac00 \uc911\uc694\ud558\uba70\n\ub300\uc778\uad00\uacc4\ub97c \ud615\uc131\ud560 \ub54c\ub294 \uc9c4\uc2e4\ud55c \uad00\uacc4\ub97c \ub9fa\uace0\uc790 \ud569\ub2c8\ub2e4.\n\ud55c\ub9c8\ub514\ub85c \ud655\uace0\ud55c \uc2e0\ub150\uacfc \ub69c\ub837\ud55c \uc6d0\ub9ac\uc6d0\uce59\uc744 \uac00\uc9c0\uace0 \uc0b6\uc744 \uc0b4\uc544\uac00\ub294 \uc0ac\ub78c\uc785\ub2c8\ub2e4.\n\uc0ac\ud68c\uc801 \ubd88\uc758\uc5d0 \ubbfc\uac10\ud558\uc5ec \ub192\uc740 \ub3c4\ub355\uad00\ub150\uc744 \uac00\uc9c0\uace0 \uc788\uc73c\uba70\n\ubcf8\uc778\ub9cc\uc758 \ucca0\uce59\uc774 \ub69c\ub837\ud558\uae30 \ub54c\ubb38\uc5d0 \uace0\uc9d1\uc774 \uc138\ub2e4\uace0 \ub290\uaef4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n\uc0ac\ub78c\uc774\ub098 \uc77c\uc5d0 \uc788\uc5b4\uc11c \ud638\ubd88\ud638\uac00 \ubd84\uba85\ud788 \ub098\ub204\uace0\n\ud2b9\uc720\uc758 \uc5f4\uc815\uc73c\ub85c \ubcf8\uc778\uc774 \uac00\uc9c4 \ud55c\uacc4\uc810\uc744 \ub118\uc5b4\uc11c\ub294 \uac83\uc744 \uc990\uae30\uc9c0\ub9cc\n\uadf8\ub9cc\ud07c \ubc88\uc544\uc6c3\uc774 \uc624\uba74 \uc27d\uac8c \uc9c0\uce58\uac70\ub098 \uadf9\uc2ec\ud55c \uc2a4\ud2b8\ub808\uc2a4\ub97c \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\ubd84\uc7c1\uacfc \ub2e4\ud23c\uc744 \uc2eb\uc5b4\ud558\uace0 \uac08\ub4f1\uc744 \uac00\uae09\uc801 \ud53c\ud558\uace0\uc790 \ud558\ub098\n\ub3d9\uc2dc\uc5d0 \uc815\uc758\uac10\uc774 \uac15\ud558\uace0 \ub300\uccb4\ub85c \uc57d\uc790\uc758 \ud3b8\uc5d0 \uc11c\ub824\uace0 \ud558\uae30 \ub54c\ubb38\uc5d0 \ub0b4\uba74\uc758 \uac08\ub4f1\uc774 \uc7a6\uc2b5\ub2c8\ub2e4.\n\ub610\ud55c, \uacb0\ub2e8\ub825\uc774 \uc788\uc5b4 \uac70\uc808\ud560 \ub54c\ub294 \ub2e8\ud638\ud558\uac8c \uac70\uc808\ud558\uae30\ub3c4 \ud569\ub2c8\ub2e4.", "profileImageComment": null}, {"id": 5366681, "messageId": 3398, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\uc544\ub2c8 \uc774\uac70 \ub108\ubb34 \ub9db\ub530", "voiceComment": null, "status": 1, "createdAt": 1666090060000, "updatedAt": "2022-10-18T10:47:40.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 5366686, "messageId": 3398, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\ub0a8\uc5d0\uac8c \uac15\uc694\ud558\uae30\ubcf4\ub2e4\ub294 \uc790\uc2e0\uc758 \ud589\ub3d9\uacfc \uad8c\uc720\ub97c \ud1b5\ud574 \uc0ac\ub78c\ub4e4\uc758 \ub9c8\uc74c\uc744 \uc6c0\uc9c1\uc785\ub2c8\ub2e4.\n\ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc758 \uc131\uc7a5\uacfc \ubc1c\uc804\uc5d0\ub3c4 \uad00\uc2ec\uc774 \ub9ce\uc73c\uba70 \uadf8\uac83\uc744 \ub3c4\uc640\uc8fc\uace0\uc790 \ub178\ub825\ud569\ub2c8\ub2e4.\n\uc790\uc2e0\uc758 \ubc14\uc6b4\ub354\ub9ac \uc548\uc5d0 \ub4e4\uc5b4\uc628 \uc0ac\ub78c\ub4e4\uc5d0\uac8c\ub294 \ubaa8\ub4e0 \uac83\uc744 \ub0b4\uc5b4\uc904 \uc815\ub3c4\ub85c \ud5cc\uc2e0\uc801\uc774\ub098\n\uadf8 \ubc14\uc6b4\ub354\ub9ac\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uac83\uc774 \ub9e4\uc6b0 \uae4c\ub2e4\ub86d\uace0 \ud798\ub4ed\ub2c8\ub2e4.\n\uc790\uc544\uc131\ucc30\uc744 \uc790\uc8fc \ud558\ub294 \ud3b8\uc774\uba70, \ubcf8\uc778 \uc2a4\uc2a4\ub85c\uc5d0\uac8c \ub9e4\uc6b0 \uc5c4\uaca9\ud55c \ubaa8\uc2b5\uc744 \ubcf4\uc774\uae30\ub3c4 \ud569\ub2c8\ub2e4.\n\uc790\uc2e0\uc758 \uc874\uc7ac \uc790\uccb4\uc5d0 \ub300\ud55c \uace0\ubbfc\uc73c\ub85c \ub9ce\uc740 \uc2dc\uac04\uc744 \ubcf4\ub0b4\uba70, \uc790\uc2e0\uc774 \uc0dd\uac01\ud558\ub294 \uc774\uc0c1\uc744 \uc774\ub8e8\uc9c0 \ubabb\ud558\uace0 \uc788\ub2e4\ub294 \uc0dd\uac01\uc5d0 \uc790\uc2e0\uc758 \uc0b6\uc744 \ud55c\ud0c4\ud558\uba70 \ud798\ub4e4\uc5b4\ud558\ub294 \ub9e4\uc6b0 \uc591\uc2ec\uc801\uc778 \uc0ac\ub78c\uc785\ub2c8\ub2e4.\n\ub530\ub77c\uc11c, \ud604\uc7ac \uc0c1\ud669\uc5d0\uc11c \ubb34\uc5c7\uc744 \uc644\uc218\ud560 \uc218 \uc788\ub294\uac00\uc5d0 \ub300\ud574 \uc5ec\uc720\ub97c \uac16\uace0, \ubcf4\ub2e4 \uac1c\ubc29\uc801\uc778 \uc790\uc138\ub97c \uac00\uc9c8 \ud544\uc694\uac00 \uc788\uc2b5\ub2c8\ub2e4.\n\uc0ac\uc2e4\uc801\uc774\uace0 \uad6c\uccb4\uc801\uc778 \uac83\uc744 \ubcf4\ub294 \uc2b5\uad00\uacfc \ud604\uc2e4\uac10\uac01\uc744 \ud0a4\uc6b0\ub294 \ud6c8\ub828\ud558\ub294 \uac83\uc744 \ucd94\ucc9c\ud569\ub2c8\ub2e4", "voiceComment": null, "status": 1, "createdAt": 1666090106000, "updatedAt": "2022-10-18T10:48:26.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 5366711, "messageId": 3398, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\ucf54\uc54c\ub77c \ub204\uad6c\uc57c??? \ub098\ub791 \uc798\ub9de\ub300 ~", "voiceComment": null, "status": 1, "createdAt": 1666090209000, "updatedAt": "2022-10-18T10:50:09.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 5366715, "messageId": 3398, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 3, "comment": "\u314b\u314b\u314b\u314b", "voiceComment": null, "status": 1, "createdAt": 1666090227000, "updatedAt": "2022-10-18T10:50:27.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": "\uc5b8\ub2c8 \ub355\ubd84\uc5d0 \uc778\ud504\uc81c \uc798\uc54c \ub428\u314b\u314b\u314b\u314b\u314b\u314b", "profileImageComment": null}, {"id": 5366722, "messageId": 3398, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\uc544\ub2c8\uc694\ubc88\uc5d0 \ud604\uaddc\uc0d8\ub3c4 \ub10c \ub108\ubb34 \uc5c4\uaca9\ud55c\ua