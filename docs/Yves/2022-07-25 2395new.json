 are called Chobok, Jungbok, and Malbok in order. Today is Jungbok day!\n\n\ubcf5\ub0a0\uc740 \ud55c\uad6d\uc758 \uc804\ud1b5\uc77c \uc911 \ud558\ub098\ub85c, \ub354\uc6b4 \uc5ec\ub984 \ud798\uc744 \ub0b4\uae30 \uc704\ud574 \ubcf4\ud1b5 \ub2ed \uc74c\uc2dd\uc744 \uba39\ub294 \ub0a0\uc785\ub2c8\ub2e4. \uc5ec\ub984\uc5d0\ub294 \uc138 \ubc88\uc758 \ubcf5\ub0a0\uc774 \uc788\uc73c\uba70 \uc21c\uc11c\ub300\ub85c \ucd08\ubcf5, \uc911\ubcf5, \ub9d0\ubcf5\uc774\ub77c\uace0 \ud569\ub2c8\ub2e4. \uc624\ub298\uc740 \uadf8 \uc911\uc5d0\uc11c \uc624\ub298\uc740 \uc911\ubcf5\uc785\ub2c8\ub2e4!", "voiceComment": null, "status": 1, "createdAt": 1658802960000, "updatedAt": "2022-07-26T02:36:00.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 4282273, "messageId": 2395, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\uc624\uc6b0 \uce5c\uc808 \ubc14\uc1a9\ud83e\udd79", "voiceComment": null, "status": 1, "createdAt": 1658802966000, "updatedAt": "2022-07-26T02:36:06.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221122152857_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 4282274, "messageId": 2395, "parentId": 0, "pollId": 0, "userId": 10, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\uc6c5\ub2c8\ub294 \ub3c4\uc2dc\ub77d\uba39\uc744\uac70\uc608\uc694\u3030\ufe0f", "voiceComment": null, "status": 1, "createdAt": 1658802975000, "updatedAt": "2022-07-26T02:36:15.000Z", "isArtist": "Y", "name": "\uc774\ube0c", "enName": "Yves", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/10/1669098537_20221