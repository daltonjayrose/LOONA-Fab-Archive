3)\n\n\ubab8\uc744 \uc6c0\uc9c1\uc77c\uc218\ub85d \uc6b4\uc758 \uae30\uc6b4\uc774 \uc88b\uc544\uc9d1\ub2c8\ub2e4.\u00a0\uadc0\ucc2e\uc744\uc218\ub85d \ube68\ub9ac \ub05d\ub0b4\ubc84\ub9ac\ub294 \uac83\uc774 \uc88b\uc544\uc694.\u00a0\ud55c \ubc88 \ud750\ub984\uc774 \uc7a1\ud788\uba74 \uc6d0\ud558\ub294 \ub300\ub85c \uacc4\uc18d \uc798 \ud480\ub9b4 \uac83.\n\n\ub7ed\ud0a4 \uceec\ub7ec:\ubcf4\ub77c\uc0c9\n\ud589\uc6b4\uc758 \uc5f4\uc1e0:\uc2a4\uce74\ud504\n\n\uae08\uc804\uc6b4 \ud83d\udcb8\ud83d\udcb8\ud83d\udcb8\ud83d\udcb8\n\uc5f0\uc560\uc6b4 \ud83d\udc98\ud83d\udc98\ud83d\udc98\n\ud559\uc5c5\uc6b4 \ud83d\udcdd\ud83d\udcdd\ud83d\udcdd\ud83d\udcdd\ud83d\udcdd\n\uac74\uac15\uc6b4 \ud83c\udfcb\ud83c\udfcb\ud83c\udfcb\ud83c\udfcb\ud83c\udfcb", "voiceComment": null, "status": 1, "createdAt": 1647675041000, "updatedAt": "2022-03-19T07:30:41.000Z", "isArtist": "Y", "name": "\uace0\uc6d0", "enName": "Go Won", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/12/1669278912_20221124173511_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null, "profileImageComment": null}, {"id": 1771408, "messageId": 469, "parentId": 0, "pollId": 0, "userId": 12, "groupId": 0, "isGroup": "N", "type": 0, "comment": "11.\ud669\uc18c\uc790\ub9ac\ud83d\udc02 (4/20~5/20)\n\n\uac10\uc815\uc758 \uae30\ubcf5\uc774 \uc2ec\ud560 \uc218 \uc788\uc5b4\uc694\u00a0\ubb50\ub4e0\uc9c0 \uadc0\ucc2e\uace0 \ubbf8\ub8e8\uace0 \uc2f6\uc744 \uac83 \uac19\uc2b5\ub2c8\ub2e4.\u00a0\ubb34\ub9ac\ud558\uc9c0 \ub9d0\uace0 \ucee8\ub514\uc158\uc744 \ucd5c\uc6b0\uc120\uc2dc \ud558\uc138\uc694.\n\n\ub7ed\ud0a4 \uceec\ub7ec:\ud551\ud06c\uc0c9\n\ud589\uc6b4\uc758 \uc5f4\uc1e0:\uc2a4\ud504\n\n\uae08\uc804\uc6b4 \ud83d\udcb8\ud83d\udcb8\n\uc5f0\uc560\uc6b4 \ud83d\udc98\ud83d\udc98\ud83d\udc98\n\ud559\uc5c5\uc6b4 \ud83d\udcdd\ud83d\udcdd\ud83d\udcdd\n\uac74\uac15\uc6b4 \ud83c\udfcb\n\n\uc774\ub7f4\uc218\uac00 \uac74\uac15\ucc59\uae41\uc2dc\ub2e4 \ud669\uc18c\uc790\ub9ac\uc2a4\uc