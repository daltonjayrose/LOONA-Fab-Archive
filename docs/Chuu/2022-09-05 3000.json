uc744 \uc218 \uc788\ub2e4\ub294\uac8c \uc9c4\uc9dc \ubc85\ucc28\uace0 \uafc8\ub9cc \uac19\uc558\uc5b4!!! \ud56d\uc0c1 \uc798\ud558\uace0 \uc788\uace0 \uc6b0\ub9ac\uc5d0\uac8c \ud798\uc774 \ub418\uc5b4\uc8fc\uace0 \uc788\uc73c\ub2c8\uae4c! \uc544\ud478\uc9c0\ub9cc \ub9d0\uace0 \ud558\uace0 \uc2f6\uc740 \ub300\ub85c \uac00\uace0 \uc2f6\ub300\ub85c \ud798\ucc28\uac8c \uac78\uc5b4! \ud568\uaed8 \uac08\uac8c \ub098\ub450!\n\n\uc5b8\uc81c\ub098 \uc751\uc6d0\ud574, \uc0ac\ub791\ud574\ud83d\udc96\n\n\uc624\ub298\ub3c4 \ud798\ub0b4\uc790!!!!\n\n\uc9c0\uca14 \uc798\ud558\uad6c \uc774\uc368 \uc6b8 \ub300\uc7a5!!!!!!!!\ud83d\udc4d\ud83d\udc4d\ud83d\udc4d\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96"}, {"id": 4907701, "messageId": 3000, "parentId": 0, "pollId": 0, "userId": 11, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\ub098\ub450 \uc6b0\ub9ac\uc5c4\ub9c8\uac00 \uc544\ub294 \ub178\ub798\ub77c\uc11c \uc88b\ub354\ub77c\uad6c", "voiceComment": null, "status": 1, "createdAt": 1662524500000, "updatedAt": "2022-09-07T04:21:40.000Z", "isArtist": "Y", "name": "\uce04", "enName": "Chuu", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/11/1661958745_20220901001223_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null}, {"id": 4907704, "messageId": 3000, "parentId": 0, "pollId": 0, "userId": 11, "groupId": 0, "isGroup": "N", "type": 0, "comment": "\ud83d\ude02\ud83d\udc96", "voiceComment": null, "status": 1, "createdAt": 1662524503000, "updatedAt": "2022-09-07T04:21:43.000Z", "isArtist": "Y", "name": "\uce04", "enName": "Chuu", "profileImage": "https://dnkvjm1f8biz3.cloudfront.net/images/user/profile/11/1661958745_20220901001223_f.jpg", "userNickname": "", "isLike": "N", "subComments": [], "quotedComment": null}, {"id": 4907720, "messageId": 3000, "parentId": 0, "pollId": 0, "userId": 11, "